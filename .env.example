# ==============================
# Flask 設定
# ==============================
# セッション暗号化キー（ランダムな文字列に変更してください）
SECRET_KEY=your-secret-key-change-this

# 開発環境: development / 本番環境: production
FLASK_ENV=development

# ==============================
# Dify 設定
# ==============================
# Dify APIキー（Difyのダッシュボードから取得）
DIFY_API_KEY=your-dify-api-key

# Dify APIのベースURL（デフォルトのまま使用可）
DIFY_API_URL=https://api.dify.ai/v1

# Dify KnowledgeのデータセットID（RAG検索に使用）
DIFY_DATASET_ID=your-dataset-id
